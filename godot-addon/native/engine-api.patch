+
+#ifdef TESTS_ENABLED
+// The fixture alone can install an actual project Object constant, so the
+// analyzer's dynamic getter branch has a live sentinel. This is absent from
+// normal editor builds and cannot register arbitrary symbols.
+static const StringName &validation_test_symbol() {
+	static const StringName name("ValidationEffectSentinel");
+	return name;
+}
+
+static ObjectID validation_test_object_id;
+
+bool GDScript::gdscript_validation_test_set_object(Object *p_object) {
+	if (!Thread::is_main_thread() || !Engine::get_singleton()->is_editor_hint() ||
+			GDScriptValidationContext::is_active() || p_object == nullptr ||
+			validation_test_object_id != ObjectID() ||
+			GDScriptLanguage::get_singleton()->has_any_global_constant(validation_test_symbol())) {
+		return false;
+	}
+	validation_test_object_id = p_object->get_instance_id();
+	GDScriptLanguage::get_singleton()->add_named_global_constant(validation_test_symbol(), p_object);
+	return true;
+}
+
+bool GDScript::gdscript_validation_test_clear_object() {
+	if (!Thread::is_main_thread() || !Engine::get_singleton()->is_editor_hint() ||
+			GDScriptValidationContext::is_active() || validation_test_object_id == ObjectID() ||
+			!GDScriptLanguage::get_singleton()->has_any_global_constant(validation_test_symbol())) {
+		return false;
+	}
+	Variant value = GDScriptLanguage::get_singleton()->get_any_global_constant(validation_test_symbol());
+	if (value.get_type() != Variant::OBJECT || value.get_validated_object() == nullptr ||
+			value.get_validated_object()->get_instance_id() != validation_test_object_id) {
+		return false;
+	}
+	GDScriptLanguage::get_singleton()->remove_named_global_constant(validation_test_symbol());
+	validation_test_object_id = ObjectID();
+	return true;
+}
+#endif // TESTS_ENABLED
+
+int GDScript::gdscript_validation_api_revision() {
+	return 1;
+}
+
+static bool validation_ascii_hex(const String &p_value, int p_length) {
+	if (p_value.length() != p_length) {
+		return false;
+	}
+	for (int i = 0; i < p_length; i++) {
+		const char32_t c = p_value[i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool validation_request_id(const String &p_value) {
+	if (p_value.is_empty() || p_value.length() > 64) {
+		return false;
+	}
+	for (int i = 0; i < p_value.length(); i++) {
+		const char32_t c = p_value[i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-' || c == '_')) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool validation_document_id(const Variant &p_id) {
+	if (p_id.get_type() != Variant::STRING) {
+		return false;
+	}
+	String value = p_id;
+	if (value.is_empty() || value.length() > 20 || value[0] == '0') {
+		return false;
+	}
+	for (int i = 0; i < value.length(); i++) {
+		if (value[i] < '0' || value[i] > '9') {
+			return false;
+		}
+	}
+	return true;
+}
+
+struct ValidationErrorLess {
+	bool operator()(const ScriptLanguage::ScriptError &p_a, const ScriptLanguage::ScriptError &p_b) const {
+		if (p_a.path != p_b.path) {
+			return p_a.path < p_b.path;
+		}
+		if (p_a.line != p_b.line) {
+			return p_a.line < p_b.line;
+		}
+		if (p_a.column != p_b.column) {
+			return p_a.column < p_b.column;
+		}
+		return p_a.message < p_b.message;
+	}
+};
+
+Dictionary GDScript::validate_gdscript_source(const String &p_source, const String &p_source_path, const Callable &p_read_context, const Dictionary &p_correlation) {
+	const uint64_t started_tick = OS::get_singleton()->get_ticks_usec();
+	const String source_hash = p_source.sha256_text();
+	const int64_t source_bytes = p_source.utf8().length();
+	Dictionary result;
+	result["status"] = "unavailable";
+	result["reason"] = Variant();
+	result["request_id"] = p_correlation.get("request_id", Variant());
+	result["session_id"] = p_correlation.get("session_id", Variant());
+	result["document"] = p_correlation.get("document", Variant());
+	result["purpose"] = p_correlation.get("purpose", Variant());
+	result["source_path"] = Variant();
+	Dictionary input;
+	input["source_sha256"] = source_hash;
+	input["utf8_bytes"] = source_bytes;
+	result["input"] = input;
+	result["dependencies"] = Array();
+	result["context"] = Variant();
+	result["context_current"] = false;
+	result["dependencies_current"] = false;
+	result["diagnostics"] = Array();
+	result["diagnostics_complete"] = false;
+	result["stage"] = "not_started";
+
+	String refusal;
+	Variant document_value = p_correlation.get("document", Variant());
+	Dictionary document;
+	if (document_value.get_type() == Variant::DICTIONARY) {
+		document = document_value;
+	}
+	const Variant request = p_correlation.get("request_id", Variant());
+	const Variant session = p_correlation.get("session_id", Variant());
+	const Variant expected = p_correlation.get("expected_source_sha256", Variant());
+	if (!Thread::is_main_thread() || !Engine::get_singleton()->is_editor_hint()) {
+		refusal = "wrong_thread";
+	} else if (GDScriptValidationContext::has_nested_call()) {
+		refusal = "reentrant";
+	} else if (!GDExtension::is_native_custom_callable(p_read_context)) {
+		refusal = "unsupported_effect";
+	} else if (source_bytes > 512 * 1024) {
+		refusal = "source_limit";
+	} else if (!p_source_path.begins_with("res://") || p_source_path != p_source_path.simplify_path() ||
+			!p_source_path.ends_with(".gd") || p_source_path.contains("::") || p_source_path.utf8().length() > 2048) {
+		refusal = "access_denied";
+	} else if (request.get_type() != Variant::STRING || !validation_request_id(request) ||
+			session.get_type() != Variant::STRING || !validation_ascii_hex(session, 32) ||
+			expected.get_type() != Variant::STRING || !validation_ascii_hex(expected, 64) ||
+			source_hash != String(expected) || document.is_empty() ||
+			!validation_document_id(document.get("resource_instance_id", Variant())) ||
+			!validation_document_id(document.get("editor_instance_id", Variant())) ||
+			!validation_document_id(document.get("buffer_instance_id", Variant())) ||
+			(p_correlation.get("purpose", "") != "preflight" &&
+					p_correlation.get("purpose", "") != "post_change" &&
+					p_correlation.get("purpose", "") != "unchanged")) {
+		refusal = "invalid_binding";
+	} else {
+		result["source_path"] = p_source_path;
+		GDScriptValidationContext validation(p_source_path, p_source, p_read_context);
+		List<ScriptLanguage::ScriptError> errors;
+		const bool parsed = GDScriptLanguage::get_singleton()->validate(p_source, p_source_path, nullptr, &errors, nullptr, nullptr);
+		result["stage"] = validation.get_validation_stage();
+
+		Vector<ScriptLanguage::ScriptError> sorted_errors;
+		for (const ScriptLanguage::ScriptError &error : errors) {
+			sorted_errors.push_back(error);
+		}
+		sorted_errors.sort_custom<ValidationErrorLess>();
+		Array diagnostics;
+		for (const ScriptLanguage::ScriptError &error : sorted_errors) {
+			if (diagnostics.size() == 64 || error.message.utf8().length() > 2048) {
+				validation.refuse("diagnostic_limit");
+				break;
+			}
+			Dictionary diagnostic;
+			const bool is_root = error.path == p_source_path;
+			Dictionary witness = validation.witness_for(error.path);
+			const bool known_missing = validation.get_missing_sources().has(error.path);
+			if (!is_root && witness.is_empty() && !known_missing) {
+				validation.refuse("attribution_unavailable");
+				diagnostic["path"] = Variant();
+				diagnostic["path_reason"] = "unavailable";
+				diagnostic["message"] = "Dependency diagnostic cannot be attributed.";
+			} else {
+				diagnostic["path"] = error.path;
+				diagnostic["path_reason"] = Variant();
+				diagnostic["message"] = error.message;
+			}
+			diagnostic["origin"] = is_root ? "root" : "dependency";
+			diagnostic["source_sha256"] = is_root ? Variant(source_hash) : witness.get("source_sha256", Variant());
+			diagnostic["line"] = error.line > 0 ? Variant(error.line) : Variant();
+			diagnostic["column"] = error.column > 0 ? Variant(error.column) : Variant();
+			bool parse_error = validation.get_validation_stage() == "parse";
+			if (!is_root) {
+				const Ref<GDScriptParserRef> *ref = validation.get_parser_refs().getptr(error.path);
+				parse_error = ref && ref->is_valid() && (*ref)->get_status() == GDScriptParserRef::PARSED;
+			}
+			diagnostic["category"] = parse_error ? "parse_error" : "analysis_error";
+			diagnostics.push_back(diagnostic);
+		}
+		PackedStringArray missing_paths;
+		for (const KeyValue<String, String> &missing : validation.get_missing_sources()) {
+			missing_paths.push_back(missing.key);
+		}
+		missing_paths.sort();
+		for (const String &missing_path : missing_paths) {
+			if (diagnostics.size() == 64) {
+				validation.refuse("diagnostic_limit");
+				break;
+			}
+			Dictionary diagnostic;
+			diagnostic["origin"] = "dependency";
+			diagnostic["path"] = missing_path;
+			diagnostic["path_reason"] = Variant();
+			diagnostic["source_sha256"] = Variant();
+			diagnostic["line"] = Variant();
+			diagnostic["column"] = Variant();
+			diagnostic["category"] = "missing_dependency";
+			diagnostic["message"] = "Referenced GDScript source is missing.";
+			diagnostics.push_back(diagnostic);
+		}
+		bool context_current = false;
+		bool dependencies_current = false;
+		Dictionary evidence = validation.finish(context_current, dependencies_current);
+		result["dependencies"] = evidence["dependencies"];
+		result["context"] = evidence["context"];
+		result["context_current"] = context_current;
+		result["dependencies_current"] = dependencies_current;
+		result["diagnostics"] = diagnostics;
+		if (!validation.get_failure().is_empty()) {
+			refusal = validation.get_failure();
+		} else {
+			const bool has_missing = !validation.get_missing_sources().is_empty();
+			result["status"] = parsed && !has_missing ? "valid" : "invalid";
+			result["reason"] = has_missing ? Variant("dependency_error") :
+					parsed ? Variant() : Variant(validation.get_validation_stage() == "parse" ? "parse_error" : "analysis_error");
+			result["diagnostics_complete"] = true;
+		}
+	}
+	if (!refusal.is_empty()) {
+		result["reason"] = refusal;
+		if (refusal == "access_denied" || refusal == "attribution_unavailable") {
+			// Parser messages can contain the unconfined, caller-supplied path.
+			result["diagnostics"] = Array();
+		}
+	}
+	Dictionary collection;
+	collection["clock_id"] = "editor";
+	collection["started_tick"] = uitos(started_tick);
+	collection["finished_tick"] = uitos(OS::get_singleton()->get_ticks_usec());
+	result["collection"] = collection;
+	return result;
+}
