+#include "gdscript_validation.h"
+
+#ifdef TOOLS_ENABLED
+
+#include "gdscript_compiler.h"
+#include "gdscript_parser.h"
+
+#include "core/config/project_settings.h"
+#include "core/io/resource_loader.h"
+#include "core/object/script_language.h"
+#include "core/string/translation_server.h"
+
+thread_local GDScriptValidationContext *GDScriptValidationContext::active = nullptr;
+
+GDScriptValidationContext::GDScriptValidationContext(const String &p_root_path, const String &p_source, const Callable &p_reader) :
+		reader(p_reader), root_path(p_root_path), root_source(p_source) {
+	// The caller must have rejected a nested invocation before construction.
+	active = this;
+	project_context = capture_project_context();
+}
+
+GDScriptValidationContext::~GDScriptValidationContext() {
+	// Keep the map's owning references while breaking cyclic dependency edges.
+	for (KeyValue<String, Ref<GDScriptParserRef>> &entry : parsers) {
+		entry.value->clear();
+	}
+	parsers.clear();
+	shallow_scripts.clear();
+	active = nullptr;
+}
+
+void GDScriptValidationContext::refuse(const String &p_reason) {
+	if (failure.is_empty()) {
+		failure = p_reason;
+	}
+}
+
+Dictionary GDScriptValidationContext::call_reader(const String &p_path, bool p_recheck) {
+	Variant path = p_path;
+	Variant recheck = p_recheck;
+	const Variant *arguments[] = { &path, &recheck };
+	Variant reply;
+	Callable::CallError call_error;
+	reader.callp(arguments, 2, reply, call_error);
+	if (call_error.error != Callable::CallError::CALL_OK || reply.get_type() != Variant::DICTIONARY) {
+		refuse("dependency_unavailable");
+		return Dictionary();
+	}
+	return reply;
+}
+
+String GDScriptValidationContext::resolve_path(const String &p_path, const String &p_owner) {
+	if (p_path.is_empty() || p_path.contains("::") || p_path.begins_with("uid://")) {
+		refuse("unsupported_effect");
+		return String();
+	}
+	if (p_path.begins_with("user://")) {
+		refuse("access_denied");
+		return String();
+	}
+	String candidate = p_path;
+	if (candidate.is_relative_path()) {
+		candidate = p_owner.get_base_dir().path_join(candidate);
+	}
+	candidate = candidate.simplify_path();
+	if (candidate.utf8().length() > 2048) {
+		refuse("path_limit");
+		return String();
+	}
+	if (!candidate.begins_with("res://") || candidate == "res://" || candidate.begins_with("res://../") ||
+			candidate.contains("/../")) {
+		refuse("access_denied");
+		return String();
+	}
+	if (!candidate.ends_with(".gd")) {
+		refuse("unsupported_effect");
+		return String();
+	}
+	return candidate;
+}
+
+String GDScriptValidationContext::capture_project_context() const {
+	ProjectSettings *settings = ProjectSettings::get_singleton();
+	String sample = settings->get_resource_path() + "\n" + itos(settings->get_version()) + "\n";
+	// Sort before hashing: HashMap iteration order is deliberately unspecified.
+	PackedStringArray entries;
+	LocalVector<StringName> classes;
+	ScriptServer::get_global_class_list(classes);
+	for (const StringName &name : classes) {
+		entries.push_back("class\t" + String(name) + "\t" + ScriptServer::get_global_class_path(name) + "\t" + String(ScriptServer::get_global_class_native_base(name)));
+	}
+	for (const KeyValue<StringName, ProjectSettings::AutoloadInfo> &item : settings->get_autoload_list()) {
+		entries.push_back("autoload\t" + String(item.key) + "\t" + item.value.path + "\t" + itos(item.value.is_singleton));
+	}
+	entries.sort();
+	for (const String &entry : entries) {
+		sample += entry + "\n";
+	}
+	PackedStringArray remaps;
+	for (const KeyValue<String, Vector<String>> &entry : ResourceLoader::translation_remaps) {
+		for (const String &target : entry.value) {
+			remaps.push_back(entry.key + "\t" + target);
+		}
+	}
+	remaps.sort();
+	for (const String &remap : remaps) {
+		sample += "translation-remap\t" + remap + "\n";
+	}
+	sample += "locale\t" + TranslationServer::get_singleton()->get_locale();
+	return sample.sha256_text();
+}
+
+bool GDScriptValidationContext::read_source(const String &p_path) {
+	if (p_path == root_path || sources.has(p_path)) {
+		return true;
+	}
+	if (missing.has(p_path)) {
+		return false;
+	}
+	if (sources.size() >= 32) {
+		refuse("dependency_limit");
+		return false;
+	}
+	if (ResourceLoader::translation_remaps.has(p_path)) {
+		refuse("unsupported_remap");
+		return false;
+	}
+	// ResourceLoader::path_remap itself reads .remap files and can log a raw
+	// path. Probe through the confined reader BEFORE any loader/remap callback.
+	Dictionary remap = call_reader(p_path + ".remap", false);
+	if (!failure.is_empty()) {
+		return false;
+	}
+	if (remap.get("status", "") != "missing") {
+		refuse(remap.get("reason", "unsupported_remap") == "access_denied" ? "access_denied" : "unsupported_remap");
+		return false;
+	}
+
+	Dictionary answer = call_reader(p_path, false);
+	if (!failure.is_empty()) {
+		return false;
+	}
+	String status = answer.get("status", "");
+	if (status == "missing") {
+		missing[p_path] = "missing_dependency";
+		return false;
+	}
+	if (status != "ok") {
+		String reason = answer.get("reason", "");
+		refuse(reason == "access_denied" || reason == "outside_project" ? "access_denied" :
+				reason == "unsupported_remap" ? "unsupported_remap" : "dependency_unavailable");
+		return false;
+	}
+	if (answer.get("source", Variant()).get_type() != Variant::STRING ||
+			answer.get("source_sha256", Variant()).get_type() != Variant::STRING ||
+			answer.get("identity", Variant()).get_type() != Variant::DICTIONARY ||
+			answer.get("utf8_bytes", Variant()).get_type() != Variant::INT) {
+		refuse("dependency_unavailable");
+		return false;
+	}
+	String source = answer["source"];
+	String hash = answer["source_sha256"];
+	int64_t bytes = answer["utf8_bytes"];
+	Dictionary identity = answer["identity"];
+	if (bytes < 0 || bytes > 512 * 1024 || dependency_bytes + bytes > 4 * 1024 * 1024) {
+		refuse("dependency_limit");
+		return false;
+	}
+	if (source.utf8().length() != bytes || source.sha256_text() != hash || identity.get("device", Variant()).get_type() != Variant::STRING || identity.get("inode", Variant()).get_type() != Variant::STRING) {
+		refuse("dependency_unavailable");
+		return false;
+	}
+	SourceRecord record;
+	record.source = source;
+	record.witness["path"] = p_path;
+	record.witness["identity"] = identity;
+	record.witness["source_sha256"] = hash;
+	record.witness["utf8_bytes"] = bytes;
+	sources[p_path] = record;
+	dependency_bytes += bytes;
+	return true;
+}
+
+String GDScriptValidationContext::source_for(const String &p_path) {
+	if (p_path == root_path) {
+		return root_source;
+	}
+	if (!read_source(p_path)) {
+		return String();
+	}
+	return sources[p_path].source;
+}
+
+Ref<GDScriptParserRef> GDScriptValidationContext::get_parser(const String &p_path, GDScriptParserRef::Status p_status, Error &r_error, const String &p_owner) {
+	String path = resolve_path(p_path, p_owner.is_empty() ? root_path : p_owner);
+	if (path.is_empty() || (!read_source(path) && path != root_path)) {
+		r_error = failure.is_empty() ? ERR_FILE_NOT_FOUND : ERR_UNAVAILABLE;
+		return Ref<GDScriptParserRef>();
+	}
+	Ref<GDScriptParserRef> ref;
+	if (parsers.has(path)) {
+		ref = parsers[path];
+	} else {
+		ref.instantiate();
+		ref->path = path;
+		ref->abandoned = true; // Never erase a normal parser cache entry on destruction.
+		parsers[path] = ref;
+	}
+	r_error = ref->raise_status(p_status);
+	if (!failure.is_empty()) {
+		r_error = ERR_UNAVAILABLE;
+	}
+	return ref;
+}
+
+Ref<GDScript> GDScriptValidationContext::get_shallow_script(const String &p_path, Error &r_error, const String &p_owner) {
+	String path = resolve_path(p_path, p_owner.is_empty() ? root_path : p_owner);
+	if (path.is_empty()) {
+		r_error = ERR_UNAVAILABLE;
+		return Ref<GDScript>();
+	}
+	if (shallow_scripts.has(path)) {
+		r_error = OK;
+		return shallow_scripts[path];
+	}
+	Ref<GDScriptParserRef> parsed = get_parser(path, GDScriptParserRef::PARSED, r_error, p_owner);
+	if (parsed.is_null() || r_error != OK || !failure.is_empty()) {
+		return Ref<GDScript>();
+	}
+	Ref<GDScript> script;
+	script.instantiate();
+	script->validation_shallow = true;
+	script->set_path_cache(path);
+	script->set_source_code(source_for(path));
+	// make_scripts constructs only named shallow metadata. No reload, bytecode,
+	// static initializer, script instance, ResourceLoader or global cache entry.
+	GDScriptCompiler::make_scripts(script.ptr(), parsed->get_parser()->get_tree(), false);
+	shallow_scripts[path] = script;
+	return script;
+}
+
+Dictionary GDScriptValidationContext::witness_for(const String &p_path) const {
+	if (const SourceRecord *record = sources.getptr(p_path)) {
+		return record->witness;
+	}
+	return Dictionary();
+}
+
+bool GDScriptValidationContext::allows_static_object(Object *p_object) const {
+	if (p_object == nullptr) {
+		return false;
+	}
+	if (Object::cast_to<GDScriptNativeClass>(p_object)) {
+		return true;
+	}
+	GDScript *script = Object::cast_to<GDScript>(p_object);
+	if (script == nullptr) {
+		return false;
+	}
+	for (const KeyValue<String, Ref<GDScript>> &entry : shallow_scripts) {
+		if (script->get_root_script() == entry.value.ptr()) {
+			return true;
+		}
+	}
+	return false;
+}
+
+Dictionary GDScriptValidationContext::finish(bool &r_context_current, bool &r_dependencies_current) {
+	Dictionary result;
+	result["context"] = project_context;
+	r_context_current = capture_project_context() == project_context;
+	result["context_current"] = r_context_current;
+	Array dependencies;
+	r_dependencies_current = true;
+	PackedStringArray source_paths;
+	for (const KeyValue<String, SourceRecord> &source : sources) {
+		source_paths.push_back(source.key);
+	}
+	source_paths.sort();
+	for (const String &path : source_paths) {
+		const SourceRecord &record = sources[path];
+		dependencies.push_back(record.witness);
+		if (ResourceLoader::translation_remaps.has(path) || call_reader(path + ".remap", false).get("status", "") != "missing") {
+			r_context_current = false;
+		}
+		Dictionary current = call_reader(path, true);
+		if (current.get("status", "") != "ok" || current.get("identity", Dictionary()) != record.witness["identity"] || current.get("source_sha256", "") != record.witness["source_sha256"] || current.get("utf8_bytes", -1) != record.witness["utf8_bytes"] || current.get("source", Variant()).get_type() != Variant::STRING || String(current["source"]).sha256_text() != String(record.witness["source_sha256"])) {
+			r_dependencies_current = false;
+		}
+	}
+	PackedStringArray missing_paths;
+	for (const KeyValue<String, String> &missing_source : missing) {
+		missing_paths.push_back(missing_source.key);
+	}
+	missing_paths.sort();
+	for (const String &path : missing_paths) {
+		if (ResourceLoader::translation_remaps.has(path) || call_reader(path + ".remap", false).get("status", "") != "missing") {
+			r_context_current = false;
+		}
+		if (call_reader(path, true).get("status", "") != "missing") {
+			r_dependencies_current = false;
+		}
+	}
+	result["dependencies"] = dependencies;
+	result["context_current"] = r_context_current;
+	result["dependencies_current"] = r_dependencies_current;
+	if (!r_context_current || !r_dependencies_current) {
+		refuse("context_invalidated");
+	}
+	return result;
+}
+
+#endif // TOOLS_ENABLED
