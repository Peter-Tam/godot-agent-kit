+bool GDExtension::is_native_custom_callable(const Callable &p_callable) {
+	// is_custom alone includes scripted lambdas, bound script methods, and
+	// engine method-pointer callables. Only the public native ABI constructor
+	// creates this concrete type; reject object-bound extension callbacks.
+	return p_callable.is_custom() &&
+			dynamic_cast<const CallableCustomExtension *>(p_callable.get_custom()) != nullptr &&
+			p_callable.get_object_id() == ObjectID() && p_callable.get_method() == StringName() &&
+			p_callable.is_valid();
+}
