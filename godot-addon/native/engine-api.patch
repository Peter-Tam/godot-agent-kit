+#include "core/templates/hash_map.h"
+#include "core/variant/variant.h"
+
+// Only installed during the synchronous, editor-main-thread ClassDB invocation.
+// Parser references and shallow scripts here are NOT the global cache: a cached
+// Script's source getter cannot attest which bytes built its AST or metadata.
+class GDScriptValidationContext {
+	struct SourceRecord {
+		String source;
+		Dictionary witness;
+	};
+
+	static thread_local GDScriptValidationContext *active;
+	Callable reader;
+	String root_path;
+	String root_source;
+	String failure;
+	String project_context;
+	HashMap<String, SourceRecord> sources;
+	HashMap<String, Ref<GDScriptParserRef>> parsers;
+	HashMap<String, Ref<GDScript>> shallow_scripts;
+	HashMap<String, String> missing;
+	uint64_t dependency_bytes = 0;
+	String validation_stage = "parse";
+
+	Dictionary call_reader(const String &p_path, bool p_recheck);
+	bool read_source(const String &p_path);
+	String capture_project_context() const;
+
+public:
+	static GDScriptValidationContext *get_active() { return active; }
+	static bool is_active() { return active != nullptr; }
+	static bool has_nested_call() { return active != nullptr; }
+
+	GDScriptValidationContext(const String &p_root_path, const String &p_source, const Callable &p_reader);
+	~GDScriptValidationContext();
+
+	void refuse(const String &p_reason);
+	const String &get_failure() const { return failure; }
+	String resolve_path(const String &p_path, const String &p_owner);
+	String source_for(const String &p_path);
+	Ref<GDScriptParserRef> get_parser(const String &p_path, GDScriptParserRef::Status p_status, Error &r_error, const String &p_owner);
+	Ref<GDScript> get_shallow_script(const String &p_path, Error &r_error, const String &p_owner);
+	Dictionary finish(bool &r_context_current, bool &r_dependencies_current);
+	Dictionary witness_for(const String &p_path) const;
+	void set_validation_stage(const String &p_stage) { validation_stage = p_stage; }
+	const String &get_validation_stage() const { return validation_stage; }
+	const HashMap<String, String> &get_missing_sources() const { return missing; }
+	const HashMap<String, Ref<GDScriptParserRef>> &get_parser_refs() const { return parsers; }
+	const String &get_root_path() const { return root_path; }
+	bool allows_static_object(Object *p_object) const;
+};
+
+#endif // TOOLS_ENABLED
