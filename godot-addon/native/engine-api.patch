+static bool validation_safe_value(const Variant &p_value, int p_depth = 0) {
+	if (p_depth > 32 || p_value.get_type() == Variant::OBJECT || p_value.get_type() == Variant::CALLABLE || p_value.get_type() == Variant::SIGNAL) {
+		return false;
