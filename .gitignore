# Rust build and profiling artifacts; Cargo.lock is intentionally tracked.
target/
debug/
release/
*.rs.bk
*.rlib
*.prof*

# Godot import/editor cache and Python acceptance-driver bytecode.
.godot/
__pycache__/
*.pyc

# Generated native ABI/build artifacts and installed editor-only library metadata.
godot-addon/native/build/
godot-addon/addons/godot_agent_kit/native/*.dylib
godot-addon/addons/godot_agent_kit/native/build-manifest.json

# Local environment, logs, and editor state.
.env*
*.log
.idea/
.vscode/

# Operating-system and temporary files.
.DS_Store
Thumbs.db
*.tmp
*.swp
